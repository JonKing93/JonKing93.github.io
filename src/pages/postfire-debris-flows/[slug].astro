---
import { CollectionEntry, getCollection } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";
import createSlug from "../../lib/createSlug";

export async function getStaticPaths() {
  const projectEntries = await getCollection("postfire");
  return projectEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const project = entry.data;
const { Content } = await entry.render();
---

<PostLayout
  title={project.title}
  description={project.description}
  badge={project.badge}
  heroImage={project.heroImage}
  tags={project.tags}
  github={project.github}
  gitlab={project.gitlab}
  docs={project.docs}
  paper={project.paper}
>
  <div class="flex flex-wrap gap-3 my-4 not-prose">

    <div>
      {entry.data.description && (
          <p class="text-xl italic mb-4">{entry.data.description}</p>
      )}
    </div>

    <div class="block w-full clear-both h-0 m-0 p-0"></div>

    <div class="grid grid-flow-col auto-cols-max items-stretch gap-3">
    {
        project.gitlab && (
        <a
            href={project.gitlab}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline btn-sm gap-2 flex items-center"
        >
            <img
                src="/icons/gitlab.svg"
                alt="Gitlab"
                class="w-6 h-6 inline-block" 
            />
            Repository
        </a>
        )
    }

    {
      project.github && (
        <a
          href={project.github}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline btn-sm gap-2 flex items-center"
        >
          <img
              src="/icons/github.svg"
              alt="Github"
              class="w-6 h-6 inline-block" 
          />
          Repository
        </a>
      )
    }

    {
      project.docs && (
        <a
          href={project.docs}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline btn-sm gap-2 flex items-center"
        >
          Documentation
        </a>
      )
    }

    {
      project.pdf && (
        <a
          href={entry.data.pdf}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline btn-sm gap-2 flex items-center"
        >
          PDF
        </a>
      )
    }

    {
      project.doi && (
        <a
          href={project.doi}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline btn-sm gap-2 flex items-center"
        >
          DOI
        </a>
      )
    }

    {
      project.data && (
        <a
          href={project.data}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline btn-sm gap-2 flex items-center"
        >
          Data Archive
        </a>
      )
    }

    {
      project.spec && (
        <a
          href={project.spec}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline btn-sm gap-2 flex items-center"
        >
          Data Spec
        </a>
      )
    }

    {
      project.map && (
        <a
          href={project.map}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline btn-sm gap-2 flex items-center"
        >
          Web Map
        </a>
      )
    }
    </div>

    {
      project.heroImage && (
        <div class="w-full max-w-4x1 overflow-hidden rounded-lg my-6 shadow-sm not-prose">
          <img
            src={project.heroImage}
            alt={project.title}
            class="w-full h-auto max-h-96 object-contain"
          />
        </div>
      )
    }
  </div>

  <Content />

</PostLayout>